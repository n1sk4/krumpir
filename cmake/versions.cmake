# The third-party downloads, pinned by version and SHA-256, and a download cache shared by every
# build tree (KRUMPIR_CACHE: the environment variable, else ~/.cache/krumpir, on Windows
# %LOCALAPPDATA%\krumpir). Included by cmake/krumpir.cmake; also usable in script mode (cmake -P).
#
#   krumpir_download(<url> <sha256> <out_var> [OPTIONAL])   the cached file's path; OPTIONAL: a
#                              failed download is a warning and <out_var> is empty
#   krumpir_reference_fmus(<dest> [OPTIONAL])   the Reference FMUs the runner's tests use, into <dest>
include_guard(GLOBAL)

# Reference FMUs (BSD-2), the runner's test FMUs
set(KRUMPIR_REFERENCE_FMUS_VERSION v0.0.42)
set(KRUMPIR_REFERENCE_FMUS_URL
    https://github.com/modelica/Reference-FMUs/releases/download/${KRUMPIR_REFERENCE_FMUS_VERSION}/Reference-FMUs.zip)
set(KRUMPIR_REFERENCE_FMUS_SHA256 b6b4a195b9c0f6bdd3459cd949cbb35fc21ee2049d6dab4cb7a3ba7da63b1e97)
set(KRUMPIR_REFERENCE_FMUS_FILES Feedthrough.fmu Dahlquist.fmu VanDerPol.fmu)

# The terminal UI's libraries (clients/tui)
set(KRUMPIR_FTXUI_URL https://github.com/ArthurSonzogni/FTXUI/archive/refs/tags/v7.0.3.tar.gz)
set(KRUMPIR_FTXUI_SHA256 e7c62ffe19009759821b4f0f8df7f2a6fb83784c3a9f1477d81f56d3ee723c88)
set(KRUMPIR_ASIO_URL https://github.com/chriskohlhoff/asio/archive/refs/tags/asio-1-30-2.tar.gz)
set(KRUMPIR_ASIO_SHA256 755bd7f85a4b269c67ae0ea254907c078d408cce8e1a352ad2ed664d233780e8)
set(KRUMPIR_JSON_URL https://github.com/nlohmann/json/releases/download/v3.11.3/json.tar.xz)
set(KRUMPIR_JSON_SHA256 d6c65aca6b1ed68e7a182f4757257b107ae403032760ed6ef121c9d55e81757d)
set(KRUMPIR_DOCTEST_URL https://github.com/doctest/doctest/archive/refs/tags/v2.4.11.tar.gz)
set(KRUMPIR_DOCTEST_SHA256 632ed2c05a7f53fa961381497bf8069093f0d6628c5f26286161fbd32a560186)

if(DEFINED ENV{KRUMPIR_CACHE})
  set(_krumpir_cache "$ENV{KRUMPIR_CACHE}")
elseif(CMAKE_HOST_WIN32)
  set(_krumpir_cache "$ENV{LOCALAPPDATA}/krumpir")
else()
  set(_krumpir_cache "$ENV{HOME}/.cache/krumpir")
endif()
file(TO_CMAKE_PATH "${_krumpir_cache}" _krumpir_cache)
if(CMAKE_SCRIPT_MODE_FILE)
  set(KRUMPIR_CACHE "${_krumpir_cache}")
else()
  set(KRUMPIR_CACHE "${_krumpir_cache}" CACHE PATH "Downloads shared by every build tree")
endif()

function(krumpir_download url sha256 out)
  cmake_parse_arguments(ARG "OPTIONAL" "" "" ${ARGN})
  get_filename_component(_base "${url}" NAME)
  string(SUBSTRING "${sha256}" 0 12 _id)
  set(_file "${KRUMPIR_CACHE}/${_id}-${_base}")
  set(_have "")
  if(EXISTS "${_file}")
    file(SHA256 "${_file}" _have)
  endif()
  if(NOT "${_have}" STREQUAL "${sha256}")
    message(STATUS "Downloading ${url}")
    file(DOWNLOAD "${url}" "${_file}.part" STATUS _st TLS_VERIFY ON)
    list(GET _st 0 _code)
    if(_code EQUAL 0)
      file(SHA256 "${_file}.part" _have)
    endif()
    if(NOT _code EQUAL 0 OR NOT "${_have}" STREQUAL "${sha256}")
      file(REMOVE "${_file}.part")
      set(_why "${url}: download failed (${_st})")
      if(_code EQUAL 0)
        set(_why "${url}: SHA-256 ${_have}, expected ${sha256}")
      endif()
      if(ARG_OPTIONAL)
        message(WARNING "${_why}")
        set(${out} "" PARENT_SCOPE)
        return()
      endif()
      message(FATAL_ERROR "${_why}")
    endif()
    file(RENAME "${_file}.part" "${_file}")
  endif()
  set(${out} "${_file}" PARENT_SCOPE)
endfunction()

function(krumpir_reference_fmus dest)
  set(_missing FALSE)
  foreach(_f ${KRUMPIR_REFERENCE_FMUS_FILES})
    if(NOT EXISTS "${dest}/${_f}")
      set(_missing TRUE)
    endif()
  endforeach()
  if(NOT _missing)
    return()
  endif()
  krumpir_download(${KRUMPIR_REFERENCE_FMUS_URL} ${KRUMPIR_REFERENCE_FMUS_SHA256} _zip ${ARGN})
  if(NOT _zip)
    return()
  endif()
  set(_patterns ${KRUMPIR_REFERENCE_FMUS_FILES})
  list(TRANSFORM _patterns PREPEND "3.0/")
  set(_tmp "${KRUMPIR_CACHE}/reference-fmus-${KRUMPIR_REFERENCE_FMUS_VERSION}")
  file(ARCHIVE_EXTRACT INPUT "${_zip}" DESTINATION "${_tmp}" PATTERNS ${_patterns})
  foreach(_f ${KRUMPIR_REFERENCE_FMUS_FILES})
    file(COPY "${_tmp}/3.0/${_f}" DESTINATION "${dest}")
  endforeach()
  message(STATUS "Reference FMUs ${KRUMPIR_REFERENCE_FMUS_VERSION} installed in ${dest}")
endfunction()
