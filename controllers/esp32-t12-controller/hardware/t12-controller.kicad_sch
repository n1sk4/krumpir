	(text "ESP32 T12 / T15 soldering tip controller, 24 V - protected reference design" (exclude_from_sim no) (at 20.0 14.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "60b1af9f-7039-5943-a10f-2701d2726a66"))
	(text "See docs/T12 Controller Design.md. Untested: prototype on a current-limited bench supply." (exclude_from_sim no) (at 20.0 19.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "6a87d393-8528-578f-8db8-3814a0316278"))
	(text "The buck output also feeds the DevKit 3V3 pin: do not power the board from USB and 24 V at once." (exclude_from_sim no) (at 190.0 45.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "524a7fce-6594-58b3-8179-b0fb43ff7012"))
	(text "LMR36510 values follow the datasheet 3.3 V example (22 uH, 3 x 22 uF out, 100k / 43.2k): check them." (exclude_from_sim no) (at 190.0 50.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "30a2c42c-679f-5f31-859a-89390c4f2f75"))
	(text "Everything on +24V_SW must be rated 60 V or more: the TVS can clamp as high as 45 V." (exclude_from_sim no) (at 20.0 268.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "cfc61d23-8fe1-5ff2-bc23-d04d009a7b27"))
	(text "Layout: one star ground at the negative terminal of C2. The heater return, the buck converter and the analog" (exclude_from_sim no) (at 20.0 273.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "c5d42531-d211-5fb0-b2e1-8a85352261c3"))
	(text "ground each run to it separately; keep R4, D1, C1, U3 and R2/R3 off the heater return." (exclude_from_sim no) (at 20.0 278.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "682500c8-0b56-502d-83f4-08e8701233da"))
	(text "R1 is a 2-pad 2512 shunt: route the INA240 inputs as a Kelvin connection at its pads." (exclude_from_sim no) (at 20.0 283.0 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "5ce4aed4-7453-5ffa-b8f4-96f2daf4f192"))
)
