{{ banner }}
# The firmware's main component: the hand-written control task, console and main, and the tables
# generated from controller.toml.
set(srcs
  "console.c"
  "control_task.c"
  "gen/ctrl_gen.c"
{% if m.hil %}
  "io_hil.c"
{% endif %}
  "main.c")

idf_component_register(SRCS ${srcs}
                       REQUIRES driver esp_hw_support esp_system console esp_wifi esp_netif
                                esp_event nvs_flash esp_timer)
